module shelf
kind library

# A component library somebody else published. It depends on latte and on
# nothing else — no C, no I/O, no markup compiler — which is PLAN.md's
# "shipping a library" contract from the other side of the boundary.
#
# `require path` resolves against THIS manifest's directory, so `../..` is the
# latte checkout whether this tree is `community-libs/latte` or a worktree. A
# published library would carry a git row instead; a path row is what a gate
# can run without a network.
require path "../.."
