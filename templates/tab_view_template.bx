<VStack background={self.card} border_color={self.separator} border_width={self.hairline_width}
        corner_radius={self.radius} align="stretch">
  $if !self.borderless {
    <!-- The tab row is the segmented control AppKit draws above an NSTabView:
         same bezel, same sliding pill, same padding. -->
    <HStack height={self.control_height + self.spacing} align="center" justify="center">
      <Box background={self.surface} corner_radius={self.radius}
           width={self.row_width} height={self.control_height} shrink={0}>
        $if self.selection_width > 0.0 {
          <Rectangle x={0} y={0} width={self.selection_width} height_percent={100.0}
                     offset_x={self.selection_x}
                     corner_radius={self.radius}
                     fill={self.selection_fill}
                     transition_seconds={self.motion_selection} transition_easing="ease_in_out" />
        }
        $for index in 0..self.labels.len() {
          <Label key={"tab-{index}"} text={self.labels[index]}
                 x={self.item_x[index]} y={0}
                 width={self.item_width[index]} height_percent={100.0}
                 text_color={if self.selected == index && self.active { self.on_accent } else { self.ink }}
                 font_weight={if self.selected == index { self.selected_weight } else { 0 }}
                 background={self.clear}
                 font_size={self.font_size} baseline={self.baseline} alignment={1} />
        }
      </Box>
    </HStack>
  }
</VStack>
<beans>
package templates
import latte.compose
import {view} from latte.annotations
@view
pub partial class TabViewTemplate extends compose.TabControlTemplate {
    pub fn init() { super.init() }
}
</beans>
