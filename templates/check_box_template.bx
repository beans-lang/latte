<HStack spacing={self.toggle_gap} align="start">
  <Box width={self.toggle_size} height={self.toggle_size}
       background={if self.checked || self.mixed { self.accent_fill } else { self.track_off }}
       corner_radius={self.toggle_radius}>
    $if self.checked {
      <!-- Traced off the 4x capture: the elbow sits left of centre and the
           long arm stops short of the corner. -->
      <Path d={"M{self.toggle_size * 0.22} {self.toggle_size * 0.49} L{self.toggle_size * 0.43} {self.toggle_size * 0.735} L{self.toggle_size * 0.72} {self.toggle_size * 0.285}"}
            stroke={self.on_accent} stroke_width={self.mark_stroke}
            stroke_cap="round" stroke_join="round" fill="#00000000" />
    }
    $if self.mixed {
      <Path x={(self.toggle_size - self.dash_width) / 2.0}
            y={(self.toggle_size - self.dash_thickness) / 2.0}
            width={self.dash_width} height={self.dash_thickness}
            d={"M{self.dash_thickness / 2.0} {self.dash_thickness / 2.0} L{self.dash_width - self.dash_thickness / 2.0} {self.dash_thickness / 2.0}"}
            stroke={self.on_accent} stroke_width={self.dash_thickness}
            stroke_cap="round" fill="#00000000" />
    }
  </Box>
  <Label text={self.title} text_color={self.ink} font_size={self.font_size}
         baseline={self.toggle_baseline} grow={1} height={self.toggle_size} />
</HStack>
<beans>
package templates
import latte.compose
import {view} from latte.annotations
@view
pub partial class CheckBoxTemplate extends compose.ToggleControlTemplate {
    pub fn init() { super.init() }
}
</beans>
